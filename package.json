{
  "name": "fieldnotes-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Portable, local-first AI research intake and read-only Markdown portal",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "build": "next build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm test && npm run build && npm run test:smoke",
    "intake": "node scripts/intake.mjs",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
